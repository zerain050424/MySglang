# Four consecutive workload phases for the automatic-label accuracy experiment.
# Each phase consumes fresh sessions from the task data pool.
tasks:
  - name: Codeparrot
    task_id: 0
    data_path: TaskData/Codeparrot/Qwen2.5-7B-Instruct/Code_session_data.jsonl
    mu: 0
    sigma: 0
    seed: 42
  - name: AgentBank_apps
    task_id: 1
    data_path: TaskData/AgentBankData/Qwen2.5-7B-Instruct/AgentBank_apps_session_data.jsonl
    mu: 0
    sigma: 0
    seed: 42
  - name: ShareGPT
    task_id: 2
    data_path: TaskData/SharedGPT-multi-turn/Qwen2.5-7B-Instruct/ShareGPT_cleaned_valid_deduplicated_session_data.jsonl
    mu: 4.15
    sigma: 0.971
    gap_mode: fixed
    gap_s: 20.0
    seed: 42
  - name: AgentBank_alfred
    task_id: 3
    data_path: TaskData/AgentBankData/Qwen2.5-7B-Instruct/AgentBank_alfred_scale_5000_session_data.jsonl
    mu: 1.81
    sigma: 1.092
    gap_mode: fixed
    gap_s: 2.0
    seed: 42

phases:
  - name: mixed
    duration_s: 120
    lambda_rate:
      Codeparrot: 1
      AgentBank_apps: 1
      ShareGPT: 1
      AgentBank_alfred: 1
    max_record:
      Codeparrot: 120
      AgentBank_apps: 120
      ShareGPT: 120
      AgentBank_alfred: 120
  - name: struct_dominant
    duration_s: 120
    lambda_rate:
      Codeparrot: 4
      AgentBank_apps: 1
      ShareGPT: 1
      AgentBank_alfred: 1
    max_record:
      Codeparrot: 240
      AgentBank_apps: 60
      ShareGPT: 60
      AgentBank_alfred: 60
  - name: chat_dominant
    duration_s: 120
    lambda_rate:
      Codeparrot: 1
      AgentBank_apps: 1
      ShareGPT: 4
      AgentBank_alfred: 1
    max_record:
      Codeparrot: 60
      AgentBank_apps: 60
      ShareGPT: 240
      AgentBank_alfred: 60
  - name: agentic_dominant
    duration_s: 120
    lambda_rate:
      Codeparrot: 1
      AgentBank_apps: 1
      ShareGPT: 1
      AgentBank_alfred: 4
    max_record:
      Codeparrot: 60
      AgentBank_apps: 60
      ShareGPT: 60
      AgentBank_alfred: 60
